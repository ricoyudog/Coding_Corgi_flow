{
  "name": "corgispec",
  "version": "3.0.0-rc.7",
  "description": "Unified CLI for Corgi workflow — skill management, validation, and AI instruction generation",
  "type": "module",
  "bin": {
    "corgispec": "./dist/corgispec.js"
  },
  "scripts": {
    "build": "tsup",
    "bundle:assets": "node scripts/bundle-assets.js",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "pretest": "npm run bundle:assets && npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "precoverage": "npm run bundle:assets && npm run build",
    "coverage": "vitest run --coverage",
    "validate:skills": "node dist/corgispec.js validate --path ../..",
    "check:skill-mirrors": "node scripts/check-skill-mirrors.js",
    "audit:prod": "npm audit --omit=dev --audit-level=high",
    "prepack": "npm run bundle:assets && npm run build && npm run typecheck",
    "pack:smoke": "node scripts/package-smoke.js",
    "release:check": "npm run test && npm run coverage && npm run validate:skills && npm run check:skill-mirrors && npm run audit:prod && npm run pack:smoke",
    "prepublishOnly": "npm run release:check"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "files": [
    "dist",
    "assets"
  ],
  "keywords": [
    "corgispec",
    "corgi-workflow",
    "cli",
    "workflow",
    "ai",
    "skills",
    "spec-driven-development"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ricoyudog/Coding_Corgi_flow.git",
    "directory": "packages/corgispec"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/",
    "tag": "next"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "commander": "^13.1.0",
    "js-yaml": "^4.1.0"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "4.1.10",
    "fast-check": "4.9.0",
    "tsup": "^8.3.0",
    "typescript": "^5.7.0",
    "vitest": "4.1.10"
  }
}
